# PayOps | Author: differentiatorX <madhur.m2006@gmail.com>
# Copy to .env for local development (outside Docker)
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Transactions need a replica set. Docker Compose starts one; MongoDB Atlas free tier also works.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/onyx?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-at-least-32-random-characters
# Comma-separated allowlist of registered merchant emails permitted to run platform reconciliation.
PLATFORM_ADMIN_EMAILS=
# Generate for each environment with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
WEBHOOK_SECRET_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes-base64url
CLIENT_URL=http://localhost:5173
# Where the worker reaches the API (mock bank webhooks, dev webhook sink)
INTERNAL_API_URL=http://localhost:4000

# mockbank needs no account. Switch to razorpay and add test keys to use Razorpay Checkout.
PAYMENT_PROVIDER=mockbank
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Mock bank chaos settings (0 to 1)
MOCKBANK_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters
MOCKBANK_FAILURE_RATE=0.1
MOCKBANK_TIMEOUT_RATE=0.05
MOCKBANK_DUPLICATE_RATE=0.2
MOCKBANK_REORDER_RATE=0.15
MOCKBANK_REFUND_FAILURE_RATE=0.2

PLATFORM_FEE_BPS=200
PAYMENT_EXPIRY_MINUTES=30
STUCK_PAYMENT_SECONDS=90
SETTLEMENT_DELAY_MINUTES=2
SETTLEMENT_INTERVAL_SECONDS=300
RECONCILIATION_INTERVAL_SECONDS=3600
IDEMPOTENCY_TTL_HOURS=24
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_PER_SEC=20
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_MS=10000
OPS_QUEUE_WARN_AGE_SECONDS=300
OPS_RECONCILIATION_STALE_SECONDS=7200
# Enables /dev/webhook-sink and allows webhook URLs on private hosts. Turn off in real production.
ENABLE_DEV_ROUTES=true
# Free hosting: run workers inside the API process (no separate worker service)
RUN_WORKERS_IN_API=false
