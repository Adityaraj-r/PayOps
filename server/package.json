{
  "name": "payops-server",
  "version": "1.0.0",
  "private": true,
  "description": "PayOps API and workers: payment gateway with double-entry ledger, idempotency, outbox webhooks, reconciliation and settlement",
  "author": "differentiatorX <madhur.m2006@gmail.com> (https://github.com/differentiatorX)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adityaraj-r/PayOps.git"
  },
  "homepage": "https://github.com/Adityaraj-r/PayOps#readme",
  "bugs": {
    "url": "https://github.com/Adityaraj-r/PayOps/issues"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:worker": "nodemon src/worker.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "seed": "node scripts/seed.js",
    "encrypt:webhook-secrets": "node scripts/encryptWebhookSecrets.js",
    "check:deploy-config": "node scripts/validateDeployConfig.js",
    "test": "jest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "js-yaml": "^4.3.2",
    "nodemon": "^3.1.7"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "overrides": {
    "body-parser": "^1.20.9"
  }
}
